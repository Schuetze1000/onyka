{
  "name": "@onyka/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:encrypt": "tsx src/scripts/encrypt-existing.ts",
    "db:backfill-uploads": "tsx src/scripts/backfill-upload-refs.ts"
  },
  "dependencies": {
    "@onyka/shared": "workspace:*",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.10.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "file-type": "^21.3.4",
    "helmet": "^8.3.0",
    "isomorphic-dompurify": "^2.36.0",
    "jose": "^5.10.0",
    "marked": "^17.0.6",
    "multer": "^2.5.0",
    "nanoid": "^5.1.16",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
